# Leave both empty for demo mode. Set VITE_API_URL to use Azure instead of Supabase.
VITE_API_URL=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Edge Function only — never prefix with VITE_. Set via `supabase secrets set`.
# JIRA_WEBHOOK_SECRET=

# Monthly production cost check-in. Set on the API, never in the Vite app.
# SAVINGS_ALERT_PRIMARY is emailed. SAVINGS_ALERT_SECONDARY is copied.
# Mail is sent through Microsoft Graph as SAVINGS_MAIL_FROM.
# SAVINGS_ALERT_PRIMARY=
# SAVINGS_ALERT_SECONDARY=
# SAVINGS_MAIL_FROM=
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# BOARD_URL=
