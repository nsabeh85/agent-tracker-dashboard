# Leave both empty for demo mode. Set VITE_API_URL to use Azure instead of Supabase.
VITE_API_URL=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Edge Function only — never prefix with VITE_. Set via `supabase secrets set`.
# JIRA_WEBHOOK_SECRET=

# Monthly production cost check-in. Recipients default to Justin Taylor and Ajay Sudra.
# SAVINGS_MAIL_FROM is the mailbox Microsoft sends the note from.
# SAVINGS_ALERT_PRIMARY=
# SAVINGS_ALERT_SECONDARY=
# SAVINGS_MAIL_FROM=
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# BOARD_URL=
