# Leave both empty for demo mode. Set VITE_API_URL to use Azure instead of Supabase.
VITE_API_URL=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Edge Function only — never prefix with VITE_. Set via `supabase secrets set`.
# JIRA_WEBHOOK_SECRET=

